# Shop clock used when Tirehotel files only have times, not dates.
SHOP_TIMEZONE=Europe/Stockholm

# How long a slot is when the file has a start time but no end time.
TIREHOTEL_SLOT_MINUTES=20

# Optional live pull from Compilator / Klipboard Autowork (the Tirehotel SaaS).
# Ask Compilator support for an API key, then set both of these.
# TIREHOTEL_API_URL=https://sundsvallsbildemontering.compilator.com
# TIREHOTEL_API_KEY=
# TIREHOTEL_API_PATH=/api/calendar/bookings
# TIREHOTEL_COMPANY_ID=3c7b3194-b05d-4bed-90a5-6211b699e571
# TIREHOTEL_BRANCH_ID=1

# Or paste a private ICS/calendar feed URL if Autowork can export one.
# TIREHOTEL_ICS_URL=

# How often to pull when a live feed is configured (default 5 minutes).
# TIREHOTEL_SYNC_MS=300000

# TIREHOTEL_LABEL=Tirehotel / Autowork
