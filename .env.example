# Verkstadens klocka när filer från däckhotellet bara har tid, inte datum.
SHOP_TIMEZONE=Europe/Stockholm

# Hur lång en tid är när filen har starttid men ingen sluttid.
TIREHOTEL_SLOT_MINUTES=20

# Valfri livehämtning från Compilator / Klipboard Autowork (däckhotellet).
# Be Compilator-support om en API-nyckel och sätt sedan båda dessa.
# TIREHOTEL_API_URL=https://sundsvallsbildemontering.compilator.com
# TIREHOTEL_API_KEY=
# TIREHOTEL_API_PATH=/api/calendar/bookings
# TIREHOTEL_COMPANY_ID=3c7b3194-b05d-4bed-90a5-6211b699e571
# TIREHOTEL_BRANCH_ID=1

# Eller klistra in en privat ICS-/kalenderadress om Autowork kan exportera en.
# TIREHOTEL_ICS_URL=

# Hur ofta dagen ska hämtas när ett liveflöde är satt (standard 5 minuter).
# TIREHOTEL_SYNC_MS=300000

# TIREHOTEL_LABEL=Däckhotellet / Autowork
